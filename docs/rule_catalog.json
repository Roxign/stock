     "max": 100
    }
   }
  },
  {
   "id": "d_below",
   "group": "KDJ",
   "kind": "state",
   "label": "D < {v}",
   "pl": "dv < {v}",
   "params": {
    "v": {
     "default": 20,
     "min": 0,
     "max": 100
    }
   }
  },
  {
   "id": "d_above",
   "group": "KDJ",
   "kind": "state",
   "label": "D > {v}",
   "pl": "dv > {v}",
   "params": {
    "v": {
     "default": 80,
     "min": 0,
     "max": 100
    }
   }
  },
  {
   "id": "j_below",
   "group": "KDJ",
   "kind": "state",
