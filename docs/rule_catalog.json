{
 "note": "Conditions for the rule lab. Shared by docs/rules.js (browser) and stocklab/rules.py (Python); each id is implemented in both. label/pl may use {v} (threshold) and {n} (moving-average days). kind: event = a one-bar occurrence, state = a condition that can hold for many bars. 背離: the previous high / low is the max / min over the n bars ending 5 bars ago (no future data); price = close. 鈍化: streak of consecutive bars with K beyond v.",
 "groups": [
  "KDJ",
  "MACD",
  "均線",
  "背離",
  "鈍化"
 ],
 "conditions": [
  {
   "id": "kd_golden",
   "group": "KDJ",
   "kind": "event",
   "label": "K 上穿 D（KD 黃金交叉）",
   "pl": "kv > dv and kv[1] <= dv[1]"
  },
  {
   "id": "kd_dead",
   "group": "KDJ",
   "kind": "event",
   "label": "K 下穿 D（KD 死亡交叉）",
   "pl": "kv < dv and kv[1] >= dv[1]"
  },
  {
   "id": "k_up",
   "group": "KDJ",
   "kind": "event",
   "label": "K 勾頭向上（開始反彈）",
   "pl": "kv > kv[1] and kv[1] <= kv[2]"
  },
  {
   "id": "k_down",
   "group": "KDJ",
   "kind": "event",
   "label": "K 勾頭向下（開始轉弱）",
   "pl": "kv < kv[1] and kv[1] >= kv[2]"
  },
  {
   "id": "j_up",
   "group": "KDJ",
   "kind": "event",
   "label": "J 勾頭向上",
   "pl": "jv > jv[1] and jv[1] <= jv[2]"
  },
  {
   "id": "j_down",
   "group": "KDJ",
   "kind": "event",
   "label": "J 勾頭向下",
   "pl": "jv < jv[1] and jv[1] >= jv[2]"
  },
  {
   "id": "kd_bull",
   "group": "KDJ",
   "kind": "state",
   "label": "K > D",
   "pl": "kv > dv"
  },
  {
   "id": "kd_bear",
   "group": "KDJ",
   "kind": "state",
   "label": "K < D",
   "pl": "kv < dv"
  },
  {
   "id": "k_below",
   "group": "KDJ",
   "kind": "state",
   "label": "K < {v}",
   "pl": "kv < {v}",
   "params": {
    "v": {
     "default": 20,
     "min": 0,
     "max": 100
    }
   }
  },
  {
   "id": "k_above",
   "group": "KDJ",
   "kind": "state",
   "label": "K > {v}",
   "pl": "kv > {v}",
   "params": {
    "v": {
     "default": 80,
