{
  "note": "Conditions for the rule lab. Shared by docs/rules.js (browser) and stocklab/rules.py (Python); each id is implemented in both. label/pl may use {v} (threshold) and {n} (moving-average days). kind: event = a one-bar occurrence, state = a condition that can hold for many bars.",
  "groups": ["KDJ", "MACD", "均線"],
  "conditions": [
    {"id": "kd_golden", "group": "KDJ", "kind": "event", "label": "K 上穿 D（KD 黃金交叉）", "pl": "kv > dv and kv[1] <= dv[1]"},
    {"id": "kd_dead", "group": "KDJ", "kind": "event", "label": "K 下穿 D（KD 死亡交叉）", "pl": "kv < dv and kv[1] >= dv[1]"},
    {"id": "k_up", "group": "KDJ", "kind": "event", "label": "K 勾頭向上（開始反彈）", "pl": "kv > kv[1] and kv[1] <= kv[2]"},
    {"id": "k_down", "group": "KDJ", "kind": "event", "label": "K 勾頭向下（開始轉弱）", "pl": "kv < kv[1] and kv[1] >= kv[2]"},
    {"id": "j_up", "group": "KDJ", "kind": "event", "label": "J 勾頭向上", "pl": "jv > jv[1] and jv[1] <= jv[2]"},
    {"id": "j_down", "group": "KDJ", "kind": "event", "label": "J 勾頭向下", "pl": "jv < jv[1] and jv[1] >= jv[2]"},
    {"id": "kd_bull", "group": "KDJ", "kind": "state", "label": "K > D", "pl": "kv > dv"},
    {"id": "kd_bear", "group": "KDJ", "kind": "state", "label": "K < D", "pl": "kv < dv"},
    {"id": "k_below", "group": "KDJ", "kind": "state", "label": "K < {v}", "pl": "kv < {v}", "params": {"v": {"default": 20, "min": 0, "max": 100}}},
    {"id": "k_above", "group": "KDJ", "kind": "state", "label": "K > {v}", "pl": "kv > {v}", "params": {"v": {"default": 80, "min": 0, "max": 100}}},
    {"id": "d_below", "group": "KDJ", "kind": "state", "label": "D < {v}", "pl": "dv < {v}", "params": {"v": {"default": 20, "min": 0, "max": 100}}},
    {"id": "d_above", "group": "KDJ", "kind": "state", "label": "D > {v}", "pl": "dv > {v}", "params": {"v": {"default": 80, "min": 0, "max": 100}}},
    {"id": "j_below", "group": "KDJ", "kind": "state", "label": "J < {v}", "pl": "jv < {v}", "params": {"v": {"default": 0, "min": -50, "max": 150}}},
    {"id": "j_above", "group": "KDJ", "kind": "state", "label": "J > {v}", "pl": "jv > {v}", "params": {"v": {"default": 100, "min": -50, "max": 150}}},
    {"id": "macd_golden", "group": "MACD", "kind": "event", "label": "DIF 上穿 MACD 線（柱狀體由負轉正）", "pl": "dif > macdv and dif[1] <= macdv[1]"},
    {"id": "macd_dead", "group": "MACD", "kind": "event", "label": "DIF 下穿 MACD 線（柱狀體由正轉負）", "pl": "dif < macdv and dif[1] >= macdv[1]"},
    {"id": "osc_up", "group": "MACD", "kind": "event", "label": "柱狀體勾頭向上（開始反彈）", "pl": "osc > osc[1] and osc[1] <= osc[2]"},
    {"id": "osc_down", "group": "MACD", "kind": "event", "label": "柱狀體勾頭向下（開始轉弱）", "pl": "osc < osc[1] and osc[1] >= osc[2]"},
    {"id": "osc_rising", "group": "MACD", "kind": "state", "label": "柱狀體比前一天高", "pl": "osc > osc[1]"},
    {"id": "osc_falling", "group": "MACD", "kind": "state", "label": "柱狀體比前一天低", "pl": "osc < osc[1]"},
    {"id": "dif_up", "group": "MACD", "kind": "event", "label": "DIF 勾頭向上", "pl": "dif > dif[1] and dif[1] <= dif[2]"},
    {"id": "dif_down", "group": "MACD", "kind": "event", "label": "DIF 勾頭向下", "pl": "dif < dif[1] and dif[1] >= dif[2]"},
    {"id": "osc_pos", "group": "MACD", "kind": "state", "label": "柱狀體 > 0（DIF 在 MACD 線之上）", "pl": "osc > 0"},
    {"id": "osc_neg", "group": "MACD", "kind": "state", "label": "柱狀體 < 0（DIF 在 MACD 線之下）", "pl": "osc < 0"},
    {"id": "dif_pos", "group": "MACD", "kind": "state", "label": "DIF > 0", "pl": "dif > 0"},
    {"id": "dif_neg", "group": "MACD", "kind": "state", "label": "DIF < 0", "pl": "dif < 0"},
    {"id": "zone_pos", "group": "MACD", "kind": "state", "label": "DIF 與 MACD 線都 > 0（零軸上）", "pl": "dif > 0 and macdv > 0"},
    {"id": "zone_neg", "group": "MACD", "kind": "state", "label": "DIF 與 MACD 線都 < 0（零軸下）", "pl": "dif < 0 and macdv < 0"},
    {"id": "close_above_ma", "group": "均線", "kind": "state", "label": "收盤 > {n} 日均線", "pl": "Close > Average(Close, {n})", "params": {"n": {"default": 20, "min": 2, "max": 240}}},
    {"id": "close_below_ma", "group": "均線", "kind": "state", "label": "收盤 < {n} 日均線", "pl": "Close < Average(Close, {n})", "params": {"n": {"default": 20, "min": 2, "max": 240}}},
    {"id": "ma_rising", "group": "均線", "kind": "state", "label": "{n} 日均線上揚", "pl": "Average(Close, {n}) > Average(Close, {n})[1]", "params": {"n": {"default": 60, "min": 2, "max": 240}}},
    {"id": "ma_falling", "group": "均線", "kind": "state", "label": "{n} 日均線下彎", "pl": "Average(Close, {n}) < Average(Close, {n})[1]", "params": {"n": {"default": 60, "min": 2, "max": 240}}}
  ]
}
